rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regla genérica: aplica a CUALQUIER colección (inventory, prices, y
    // las que agregues en el futuro). Cualquiera puede LEER (para que el
    // catálogo y los precios se vean sin login), pero solo un usuario
    // autenticado (tu cuenta admin) puede ESCRIBIR.
    match /{collection}/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
